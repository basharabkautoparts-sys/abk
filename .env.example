# ---------------------------------------------------------------------------
# ABK Auto Parts — environment variables
# Copy to `.env` for local dev. On Cloudflare Pages, set these in the
# dashboard (Settings → Environment variables) or via `wrangler`.
#
# LEAVE BLANK to run in DEMO MODE: the site serves bundled sample parts and a
# demo admin login (see DEMO_* below). Fill these in to go live with Supabase.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional: service-role key. Only needed if you later want server tasks that
# bypass Row Level Security (e.g. bulk import). NOT required for normal use.
SUPABASE_SERVICE_ROLE_KEY=

# Demo admin (used ONLY when Supabase is not configured, for local preview).
# In production, real staff accounts live in Supabase Auth instead.
DEMO_ADMIN_EMAIL=admin@abkautoparts.local
DEMO_ADMIN_PASSWORD=abk-demo-admin
