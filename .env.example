# ---------------------------------------------------------------------------
# ABK Auto Parts — environment variables
#
# Copy to `.env` for local dev. On GitHub Pages these are set as repository
# *variables* (Settings → Secrets and variables → Actions → Variables) and are
# read by .github/workflows/deploy.yml at build time.
#
# LEAVE BLANK to run in DEMO MODE: the site serves the bundled sample catalogue
# and a hard-coded admin login (admin@abkautoparts.local / abk-demo-admin).
# Fill these in to work against real Supabase data.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API). Both values are public by design:
# they ship in the JavaScript bundle, and Row Level Security is what actually
# protects the data. Never put a service-role key here.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Where the site is served from. In CI both of these come from
# actions/configure-pages, so they follow the Pages settings automatically —
# set them by hand only to reproduce a production build locally.
#   BASE_PATH:       subdirectory, no trailing slash. "/abk" for the GitHub
#                    Pages project site; "" for a custom domain at the root.
#   PUBLIC_SITE_URL: origin only, no trailing slash and no base path.
# BASE_PATH=/abk
# PUBLIC_SITE_URL=https://basharabkautoparts-sys.github.io
